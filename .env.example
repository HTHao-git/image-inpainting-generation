# Environment variables template
# Copy this file to .env and fill in your values

# Weights & Biases (optional)
WANDB_API_KEY="enter_your_wandb_api_key_here"
WANDB_PROJECT=image-inpainting-generation

# Hugging Face (for downloading models)
HF_TOKEN="enter_your_hugging_face_token_here"

# CUDA settings
CUDA_VISIBLE_DEVICES=0

# Data paths
DATA_ROOT=./data
OUTPUT_ROOT=./outputs

# Training settings
MIXED_PRECISION=true